model Project {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           Json
  description    Json
  body           Json?
  category       String
  year           Int
  client         String?
  tags           String[]
  coverImage     String?
  galleryImages  String[]
  seoTitle       Json?
  seoDescription Json?
  ogImage        String?
  featured       Boolean   @default(false)
  published      Boolean   @default(false)
  includeSitemap Boolean   @default(true)
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  publishedAt    DateTime?

  @@index([published, position])
  @@index([category])
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

model Review {
  id          String       @id @default(cuid())
  authorName  String
  role        String?
  company     String?
  locale      String
  text        String       @db.Text
  rating      Int          @default(5)
  siteUrl     String?
  source      String?
  projectId   String?
  status      ReviewStatus @default(PENDING)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?

  @@index([locale, status, position])
}
