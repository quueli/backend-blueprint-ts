enum Role {
  OWNER
  ADMIN
  EDITOR
  DESIGNER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(EDITOR)
  avatarColor  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?
  ownedLeads   Lead[]     @relation("LeadOwner")
  comments     Comment[]
  activities   Activity[]
}
